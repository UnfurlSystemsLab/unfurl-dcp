{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unfurl:authoring:adapter-result",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "validated",
        "runnable",
        "authored"
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "$ref": "urn:unfurl:authoring:common#/$defs/selected"
    },
    "governance": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/governance"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/check"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/connection"
      }
    },
    "callPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "operations"
      ],
      "properties": {
        "manifest": {
          "$ref": "urn:unfurl:authoring:common#/$defs/artifact"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "status",
    "requestId",
    "adapter",
    "governance",
    "checks",
    "limitations"
  ],
  "additionalProperties": false
}
