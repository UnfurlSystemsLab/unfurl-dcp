{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unfurl:authoring:package-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "format": "uuid"},
    "packageName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "readiness": {"enum": ["authored", "validated", "runnable", "blocked"]},
    "unresolvedNeeds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "urn:unfurl:authoring:common#/$defs/artifact"}}
  },
  "required": ["schemaVersion", "runId", "packageName", "planDigest", "readiness", "unresolvedNeeds", "artifacts"],
  "additionalProperties": false
}
