{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unfurl:authoring:package-run",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "format": "uuid"},
    "state": {"enum": ["admitted", "running", "waiting-for-input", "waiting-for-approval", "blocked", "cancelling", "cancelled", "failed", "completed"]},
    "readiness": {"enum": ["draft", "authored", "validated", "runnable", "blocked"]},
    "revision": {"type": "integer", "minimum": 0},
    "completedStages": {"type": "integer", "minimum": 0, "maximum": 32},
    "code": {"type": "string", "minLength": 1},
    "unresolvedNeeds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interaction": {"$ref": "urn:unfurl:authoring:package-interaction"},
    "package": {"allOf": [{"$ref": "urn:unfurl:authoring:common#/$defs/artifact"}, {"properties": {"kind": {"const": "package-archive"}, "path": {"const": ".package/package.zip"}}}]},
    "manifest": {"allOf": [{"$ref": "urn:unfurl:authoring:common#/$defs/artifact"}, {"properties": {"kind": {"const": "package-manifest"}, "path": {"const": ".package/manifest.json"}}}]},
    "evidence": {"type": "array", "items": {"$ref": "urn:unfurl:authoring:common#/$defs/artifact"}}
  },
  "required": ["schemaVersion", "runId", "state", "readiness", "revision", "completedStages", "code", "unresolvedNeeds"],
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["waiting-for-input", "waiting-for-approval"]}}}, "then": {"required": ["interaction"]}},
    {"if": {"properties": {"state": {"const": "completed"}}}, "then": {"required": ["package", "manifest", "evidence"], "properties": {"readiness": {"enum": ["authored", "validated", "runnable", "blocked"]}, "evidence": {"minItems": 1}}}}
  ]
}
