{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unfurl:authoring:assembly-progress",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "validated",
        "runnable",
        "authored"
      ]
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "flow": {
      "type": "string",
      "minLength": 1
    },
    "requiredOperations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "stage": {
      "enum": [
        "interview",
        "adapters",
        "governance",
        "compose",
        "graphs",
        "ui",
        "verify",
        "done"
      ]
    },
    "completedStages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selectedAdapters": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/selected"
      },
      "minItems": 0
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolvedNeeds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "governance": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/governance"
      },
      "minItems": 0
    },
    "runtime": {
      "enum": [
        "none",
        "flow",
        "foundry",
        "both",
        "undecided"
      ]
    },
    "ui": {
      "enum": [
        "backend-only",
        "unfurl-ui",
        "custom",
        "undecided"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/artifact"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/check"
      },
      "minItems": 0
    },
    "adapterRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "component",
          "requiredOperations"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "requiredOperations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/connection"
      }
    },
    "strategyComponents": {
      "type": "array",
      "items": {
        "$ref": "urn:unfurl:authoring:common#/$defs/strategy"
      }
    },
    "callPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "operations"
      ],
      "properties": {
        "manifest": {
          "$ref": "urn:unfurl:authoring:common#/$defs/artifact"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "status",
    "component",
    "flow",
    "requiredOperations",
    "requirements",
    "decisions",
    "stage",
    "completedStages",
    "selectedAdapters",
    "dependencies",
    "unresolvedNeeds",
    "governance",
    "runtime",
    "ui",
    "artifacts",
    "checks",
    "adapterRequests"
  ],
  "additionalProperties": false
}
